#!/usr/bin/env python3
import os
import subprocess

import mycgi

print ("Content-Type: text/html\n")
#genom --> orf

form = mycgi.Form()

#Inputs
fasta = form["fasta"]
features = form["features"]

#Datein speichern
os.makedirs("uploads", exist_ok=True)
orf_path = "uploads/cgi.fasta"
feat_path = "uploads/cgi.features.tsv"

with open(orf_path, "w") as f:
    f.write(fasta.value)

with open(feat_path, "w") as f:
    f.write(features.value)

# 1) GENOM to ORF
output1 = subprocess.run(["python3", "genome2orf.py", "--organism", orf_path, "--features", feat_path], capture_output=True, text = True, check = True)

#if (output1.returncode == 0):

# 2) DNA to mRNA
output2 = subprocess.run(["python3", "dna2mrna.py", "--fasta", "-"], input = output1.stdout, capture_output=True, text = True, check = True)

# 3) mRNA to PROTEIN
output3 = subprocess.run(["python3", "mrna2aa.py", "--fasta", "-"], input = output2.stdout, capture_output=True, text = True, check = True)

#Output
result = output3

print("""
<!DOCTYPE html>
<html>
  <body>
    <h1>Transformation Genom+Feature to Protein with its Lotus-Tag</h1>
    <p> Pls insert a fasta file which should be analysed </p>
    <p> The output of the programm will be shown after you hit the button send </p>
    <form method="post" enctype="multipart/form-data">
      <input type="file" name="fasta" required>
      <input type="file" name="features" required>
      <input type="submit" value="send">
    </form>
    <h2> Output </h2>
    <pre>
    """)
print(result)

print("""
     </pre>
  </body>
</html>
""")
